# Required to turn the generator on. Without it the form is hidden and the
# site is a plain gallery.
OPENAI_API_KEY=

# Persistent storage for generated Dits. Without it they are written to
# public/generated/ on the local filesystem, which works in development but
# not on serverless hosts. Create a Blob store in the Vercel dashboard, then
# `vercel env pull` to get this value.
BLOB_READ_WRITE_TOKEN=

# Spend controls. The daily cap counts stored Dits and is the real ceiling;
# the per-minute limit is per-IP and best-effort.
DIT_DAILY_CAP=50
DIT_RATE_LIMIT_PER_MINUTE=3

# low ~$0.006/image, medium ~$0.04, high ~$0.17 at this size.
DIT_QUALITY=low
DIT_SIZE=1024x1536
DIT_MODEL=gpt-image-2
